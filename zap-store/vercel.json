{
  "version": 2,
  "builds": [
    {
      "src": "zap-store/backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "zap-store/backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "zap-store/frontend/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "zap-store/frontend/index.html"
    }
  ]
}
